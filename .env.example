# GoRest API access token (https://gorest.co.in/) — required for the `api` project.
# Generate one from your GoRest account settings, then copy this file to .env.
GOREST_TOKEN=your_gorest_access_token_here

# BearStore test account credentials — required to run the `setup` project
# (npx playwright test --project=setup), which logs in and saves storageState.
BEARSTORE_USERNAME=your_bearstore_username_here
BEARSTORE_PASSWORD=your_bearstore_password_here
